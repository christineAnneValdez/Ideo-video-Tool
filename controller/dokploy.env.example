# Required core values
OPENTALK_CTRL_FRONTEND__BASE_URL=https://your-frontend-domain.com
OPENTALK_CTRL_HTTP__ADDR=0.0.0.0
OPENTALK_CTRL_HTTP__PORT=11311
OPENTALK_CTRL_DATABASE__URL=postgres://postgres:password@postgres:5432/opentalk

# OIDC / Keycloak
OPENTALK_CTRL_OIDC__AUTHORITY=https://keycloak.your-domain.com/realms/OPENTALK
OPENTALK_CTRL_OIDC__FRONTEND__CLIENT_ID=Frontend
OPENTALK_CTRL_OIDC__CONTROLLER__CLIENT_ID=Controller
OPENTALK_CTRL_OIDC__CONTROLLER__CLIENT_SECRET=replace-me
OPENTALK_CTRL_USER_SEARCH__BACKEND=keycloak_webapi
OPENTALK_CTRL_USER_SEARCH__API_BASE_URL=https://keycloak.your-domain.com/admin/realms/OPENTALK
OPENTALK_CTRL_USER_SEARCH__USERS_FIND_BEHAVIOR=from_user_search_backend

# LiveKit
OPENTALK_CTRL_LIVEKIT__PUBLIC_URL=wss://livekit.your-domain.com
OPENTALK_CTRL_LIVEKIT__SERVICE_URL=http://livekit:7880
OPENTALK_CTRL_LIVEKIT__API_KEY=replace-me
OPENTALK_CTRL_LIVEKIT__API_SECRET=replace-me

# MinIO
OPENTALK_CTRL_MINIO__URI=http://minio:9000
OPENTALK_CTRL_MINIO__BUCKET=controller
OPENTALK_CTRL_MINIO__ACCESS_KEY=minioadmin
OPENTALK_CTRL_MINIO__SECRET_KEY=minioadmin

# Optional integrations
# OPENTALK_CTRL_RABBIT_MQ__URL=amqp://guest:guest@rabbitmq:5672
# OPENTALK_CTRL_RABBIT_MQ__MAIL_TASK_QUEUE=opentalk_mailer
# OPENTALK_CTRL_RABBIT_MQ__RECORDING_TASK_QUEUE=opentalk_recorder
# OPENTALK_CTRL_REDIS__URL=redis://redis:6379/
