# Single-stack deployment defaults (Controller + Frontend + Keycloak + deps)

# Public URLs / ports
FRONTEND_BASE_URL=http://localhost:3000
FRONTEND_CONTROLLER_HOST=localhost:11311
OIDC_ISSUER_PUBLIC_URL=http://localhost:8080/realms/OPENTALK
LIVEKIT_PUBLIC_URL=ws://localhost:7880

FRONTEND_PORT=3000
CONTROLLER_PORT=11311
KEYCLOAK_PORT=8080
LIVEKIT_PORT=7880
LIVEKIT_UDP_PORT=7882
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Controller DB
POSTGRES_DB=opentalk
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Keycloak DB
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=keycloak

# Keycloak bootstrap
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_REALM=OPENTALK

# OIDC clients
FRONTEND_OIDC_CLIENT_ID=Frontend
CONTROLLER_OIDC_CLIENT_ID=Controller
CONTROLLER_OIDC_CLIENT_SECRET=local-dev-secret

# Controller user search behavior
USERS_FIND_BEHAVIOR=from_user_search_backend

# LiveKit credentials
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# MinIO credentials
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=controller

# Frontend flags
FRONTEND_INSECURE=true
